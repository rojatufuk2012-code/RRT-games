<script>

let player = 0;
let cpu = 0;

/* BOSS GAME */
let bossHp = 50;
let playerHp = 30;

/* ========== MENU ========== */
function startDice(){
  hideAll();
  document.getElementById("diceGame").style.display="block";
}

function startReaction(){
  hideAll();
  document.getElementById("reactionGame").style.display="block";
}

function startBoss(){
  hideAll();
  document.getElementById("bossGame").style.display="block";
  resetBoss();
}

function backMenu(){
  hideAll();
  document.getElementById("menu").style.display="block";
}

function hideAll(){
  document.getElementById("menu").style.display="none";
  document.getElementById("diceGame").style.display="none";
  document.getElementById("reactionGame").style.display="none";
  document.getElementById("bossGame").style.display="none";
}

/* ========== DICE GAME ========== */
function rollDice(){

  const d1 = Math.floor(Math.random()*6)+1;
  const d2 = Math.floor(Math.random()*6)+1;

  player += d1;
  cpu += d2;

  document.getElementById("d1").innerText = "DU: " + d1;
  document.getElementById("d2").innerText = "CPU: " + d2;

  document.getElementById("score").innerText =
    "Score: " + player + " | " + cpu;

  if(player >= 20){
    alert("DU GEWINNST!");
    resetDice();
  }

  if(cpu >= 20){
    alert("CPU GEWINNT!");
    resetDice();
  }
}

function resetDice(){
  player = 0;
  cpu = 0;

  document.getElementById("d1").innerText = "-";
  document.getElementById("d2").innerText = "-";
  document.getElementById("score").innerText = "Score: 0 | 0";
}

/* ========== REACTION GAME ========== */

let startTime = 0;
let reactionActive = false;

function startReactionTest(){

  if(reactionActive) return;

  reactionActive = true;

  const text = document.getElementById("reactionText");
  text.innerText = "Warte auf GRÜN...";

  const delay = Math.random()*3000 + 2000;

  setTimeout(() => {

    text.innerText = "JETZT KLICKEN!";
    startTime = Date.now();

  }, delay);
}

/* Besser: nur Button statt globalem Klick */
function handleReactionClick(){

  if(!reactionActive || startTime === 0) return;

  const reaction = Date.now() - startTime;

  document.getElementById("reactionText").innerText =
    "Zeit: " + reaction + " ms";

  startTime = 0;
  reactionActive = false;
}

/* ========== BOSS GAME ========== */

function resetBoss(){
  bossHp = 50;
  playerHp = 30;

  updateBossUI();
  document.getElementById("bossText").innerText = "Der Boss erscheint...";
}

function updateBossUI(){
  document.getElementById("bossHp").innerText = "Boss HP: " + bossHp;
  document.getElementById("playerHp").innerText = "Deine HP: " + playerHp;
}

function attackBoss(){

  if(bossHp <= 0 || playerHp <= 0) return;

  const playerDmg = Math.floor(Math.random()*6)+1;
  const bossDmg = Math.floor(Math.random()*5)+1;

  bossHp -= playerDmg;
  playerHp -= bossDmg;

  updateBossUI();

  document.getElementById("bossText").innerText =
    `Du: -${playerDmg} | Boss: -${bossDmg}`;

  checkBoss();
}

function checkBoss(){

  if(bossHp <= 0){
    alert("BOSS BESIEGT!");
    resetBoss();
    backMenu();
  }

  if(playerHp <= 0){
    alert("DU VERLOREN!");
    resetBoss();
    backMenu();
  }
}

</script>
