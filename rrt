<script>

let player = 0;
let cpu = 0;

/* BOSS */
let bossHp = 50;
let playerHp = 30;

/* MENU */
function startDice(){
  document.getElementById("menu").style.display="none";
  document.getElementById("diceGame").style.display="block";
  document.getElementById("reactionGame").style.display="none";
  document.getElementById("bossGame").style.display="none";
}

function startReaction(){
  document.getElementById("menu").style.display="none";
  document.getElementById("diceGame").style.display="none";
  document.getElementById("reactionGame").style.display="block";
  document.getElementById("bossGame").style.display="none";
}

function startBoss(){
  document.getElementById("menu").style.display="none";
  document.getElementById("diceGame").style.display="none";
  document.getElementById("reactionGame").style.display="none";
  document.getElementById("bossGame").style.display="block";

  resetBoss();
}

function backMenu(){
  document.getElementById("menu").style.display="block";
  document.getElementById("diceGame").style.display="none";
  document.getElementById("reactionGame").style.display="none";
  document.getElementById("bossGame").style.display="none";
}

/* DICE GAME */
function rollDice(){

  let d1 = Math.floor(Math.random()*6)+1;
  let d2 = Math.floor(Math.random()*6)+1;

  player += d1;
  cpu += d2;

  document.getElementById("d1").innerText = "DU: " + d1;
  document.getElementById("d2").innerText = "CPU: " + d2;

  document.getElementById("score").innerText =
    "Score: " + player + " | " + cpu;

  if(player >= 20){
    alert("DU GEWINNST!");
    resetDice();
  }

  if(cpu >= 20){
    alert("CPU GEWINNT!");
    resetDice();
  }
}

function resetDice(){
  player = 0;
  cpu = 0;

  document.getElementById("d1").innerText = "-";
  document.getElementById("d2").innerText = "-";
  document.getElementById("score").innerText = "Score: 0 | 0";
}

/* REACTION GAME */
let startTime;
let reactionActive = false;

function startReactionTest(){

  if(reactionActive) return;

  reactionActive = true;

  let text = document.getElementById("reactionText");
  text.innerText = "Warte auf GRÜN...";

  let delay = Math.random()*3000 + 2000;

  setTimeout(()=>{

    text.innerText = "JETZT KLICKEN!";
    startTime = Date.now();

    document.addEventListener("click", handleReaction);

  }, delay);
}

function handleReaction(){

  if(!startTime) return;

  let reaction = Date.now() - startTime;

  alert("Deine Zeit: " + reaction + " ms");

  document.removeEventListener("click", handleReaction);

  document.getElementById("reactionText").innerText = "Warte auf Grün...";

  startTime = null;
  reactionActive = false;
}

/* BOSS GAME */
function resetBoss(){
  bossHp = 50;
  playerHp = 30;

  updateBossUI();
  document.getElementById("bossText").innerText = "Der Boss erscheint...";
}

function updateBossUI(){
  document.getElementById("bossHp").innerText = "Boss HP: " + bossHp;
  document.getElementById("playerHp").innerText = "Deine HP: " + playerHp;
}

function attackBoss(){

  if(bossHp <= 0 || playerHp <= 0) return;

  let playerDmg = Math.floor(Math.random()*6)+1;
  let bossDmg = Math.floor(Math.random()*5)+1;

  bossHp -= playerDmg;
  playerHp -= bossDmg;

  updateBossUI();

  document.getElementById("bossText").innerText =
    "Du machst " + playerDmg + " Schaden | Boss macht " + bossDmg;

  checkBoss();
}

function checkBoss(){

  if(bossHp <= 0){
    alert("DU HAST DEN BOSS BESIEGT!");
    resetBoss();
    backMenu();
  }

  if(playerHp <= 0){
    alert("DU WURDEST BESIEGT!");
    resetBoss();
    backMenu();
  }
}

</script>
